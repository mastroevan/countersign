# Copy to backend/.env and fill in. Never commit real values.
RING_ACCESS_TOKEN=
RING_DEVICE_PACKAGE=
RING_DEVICE_MOTION=
COUNTERSIGN_DEVICE_TZ=America/Denver
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
COUNTERSIGN_EVIDENCE_BUCKET=
RECHECK_DELAY_S=60
PUBLIC_BASE_URL=http://localhost:8000
# Demo only: enables POST /api/bindings (changes which camera a tracker reads). Leave unset otherwise.
COUNTERSIGN_SCENARIOS=true
# Offline demo needs none of the values above: see README "Try it".
